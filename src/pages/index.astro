---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Acaiaca Institute"
	description="Acaiaca Institute exists to understand, preserve, and amplify human judgment in an AI-augmented world."
>
	<main class="homepage">
		<section class="placeholder">
			<p class="eyebrow">Acaiaca Institute</p>

			<h1>
				Understanding, preserving, and amplifying human judgment in an
				AI-augmented world.
			</h1>

			<p class="lede">
				The implementation foundation is in place.
			</p>
		</section>
	</main>
</Layout>

<style>
	.homepage {
		min-height: 100vh;
	}

	.placeholder {
		width: min(1120px, calc(100% - 48px));
		margin-inline: auto;
		padding-block: 160px;
	}

	.eyebrow {
		margin: 0 0 24px;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 900px;
		margin: 0;
		font-size: clamp(3rem, 7vw, 6.5rem);
		font-weight: 400;
		line-height: 0.98;
		letter-spacing: -0.045em;
	}

	.lede {
		max-width: 640px;
		margin: 48px 0 0;
		font-size: 1.125rem;
		line-height: 1.6;
	}
</style>